:root{--bg:#f3f6f9;--fg:#14202b;--card:#fff;--line:#cfd9e2;--acc:#0a7d6b;--accfg:#fff;--bad:#c0392b;--good:#1e8449;--warn:#b9770e;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b121a;--fg:#d6e2ee;--card:#121c27;--line:#25364a;--acc:#27d3b0;--accfg:#04231d;--bad:#ff6b5c;--good:#4cd48a;--warn:#f0b64a}}
:root[data-theme="dark"]{--bg:#0b121a;--fg:#d6e2ee;--card:#121c27;--line:#25364a;--acc:#27d3b0;--accfg:#04231d;--bad:#ff6b5c;--good:#4cd48a;--warn:#f0b64a}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;line-height:1.5}
body{padding:16px;display:flex;justify-content:center}
.w{width:100%;max-width:720px}
h1{font-family:var(--mono);font-size:20px;margin:0;color:var(--acc);cursor:pointer}
h2{font-size:20px;margin:4px 0 8px}h3{margin:0 0 4px;font-size:16px}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.hud{display:flex;gap:12px;font-family:var(--mono);font-size:13px;align-items:center;flex-wrap:wrap}
.meter{width:80px;height:8px;background:var(--line);border-radius:4px;overflow:hidden;display:inline-block;vertical-align:middle}
.meter i{display:block;height:100%;background:var(--bad);transition:width .3s}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:12px}
.tag{font-family:var(--mono);font-size:12px;color:var(--acc);letter-spacing:.06em}
.ev{display:block;width:100%;text-align:left;background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin:8px 0;font-family:var(--mono);font-size:13px;cursor:pointer;white-space:pre-wrap;word-break:break-word}
.ev:hover{border-color:var(--acc)}.ev.seen{border-style:dashed}
.note{display:block;margin-top:6px;font-family:system-ui,sans-serif;font-size:13px;color:var(--warn)}
.ch{display:block;width:100%;text-align:left;background:var(--card);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin:8px 0;font-size:15px;cursor:pointer}
.ch:hover:not(:disabled){border-color:var(--acc)}
.ch.ok{border-color:var(--good);background:color-mix(in srgb,var(--good) 15%,transparent)}
.ch.part{border-color:var(--warn);background:color-mix(in srgb,var(--warn) 15%,transparent)}
.ch.no{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 15%,transparent)}
.ch:disabled{cursor:default;color:var(--fg)}
.btn{background:var(--acc);color:var(--accfg);border:0;border-radius:8px;padding:10px 18px;font-size:15px;font-weight:700;cursor:pointer;margin:4px 6px 4px 0}
.btn.s{background:transparent;color:var(--fg);border:1px solid var(--line);font-weight:500}
.btn:disabled{opacity:.5;cursor:default}
.fb{margin-top:10px;padding:12px;border-radius:8px;border-left:4px solid var(--acc);background:var(--bg);font-size:14px}
.sm{font-size:13px;opacity:.8}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.st{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px;text-align:center}
.st b{display:block;font-size:22px;font-family:var(--mono);color:var(--acc)}
.lock{opacity:.45}
.stars{color:var(--warn);letter-spacing:2px}
.big{font-family:var(--mono);font-size:30px;color:var(--acc)}
ul{padding-left:20px;margin:6px 0}
